# Copy to .env.local; never commit credentials.
APP_URL=http://localhost:3000
RETIUM_RPC_URL=https://rpc.retium.org
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
# Required on Vercel; use the SAME pooled Neon database for the local bot and worker.
DATABASE_URL=REPLACE_WITH_YOUR_POSTGRESQL_CONNECTION_STRING
